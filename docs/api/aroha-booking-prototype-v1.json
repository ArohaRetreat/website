{
  "openapi": "3.1.0",
  "info": {
    "title": "Aroha local booking review API",
    "version": "0.1.0",
    "description": "Synthetic loopback prototype only. Not the production /api/v1 contract. Single-process serialised JSON persistence. No Firebase, payment, external calendar, email or Dynatrace transport. Currency INR in integer paise. Dates Asia/Kolkata; half-open arrival/departure. Snapshot terms and pending expiry apply. Idempotency scoped to actor and key; mismatched request returns409. Full prototype snapshot is intentionally bounded only by local review data; production needs paginated DTOs and distributed ledgers."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8782/prototype-api/v1"
    }
  ],
  "paths": {
    "/state": {
      "get": {
        "operationId": "state",
        "summary": "Own projected snapshot or host workspace. Anonymous receives no bookings.",
        "security": [],
        "responses": {
          "200": {
            "description": "Snapshot: prototype, now, actor, settings, units, own bookings/loyalty, host-only promos/users/blocks/audit, delivery and revision. Private response, no-store."
          }
        }
      }
    },
    "/session": {
      "post": {
        "operationId": "session",
        "summary": "Choose an explicitly synthetic local persona. No production authentication.",
        "security": [],
