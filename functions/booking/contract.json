{
  "availability": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "arrival": {
        "type": "string",
        "format": "date"
      },
      "departure": {
        "type": "string",
        "format": "date"
      },
      "guests": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200
      },
      "kind": {
        "type": "string",
        "enum": [
          "day",
          "individual",
          "private",
          "event"
        ]
      },
      "adults": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "childrenAges": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      },
      "units": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 100
        },
        "minItems": 0,
        "maxItems": 9,
        "uniqueItems": true
      }
    },
    "required": [
      "arrival",
      "departure",
      "guests"
    ]
  },
  "quote": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "arrival": {
        "type": "string",
        "format": "date"
      },
      "departure": {
        "type": "string",
        "format": "date"
      },
      "guests": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200
      },
      "units": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 100
        },
        "minItems": 0,
        "maxItems": 9,
        "uniqueItems": true
      },
      "promo": {
        "type": "string",
        "maxLength": 32
      },
      "guestId": {
        "type": "string",
        "maxLength": 128
      },
      "kind": {
        "type": "string",
        "enum": [
          "day",
          "individual",
          "private",
          "event"
        ]
      },
      "adults": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "childrenAges": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      },
      "redeemCredits": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000000
      }
    },
    "required": [
      "arrival",
      "departure",
      "guests",
      "units"
    ]
  },
  "create": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "quoteId": {
        "type": "string",
        "maxLength": 100
      },
      "note": {
        "type": "string",
        "maxLength": 1000
      },
      "contact": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "phone"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "phone": {
            "type": "string",
            "maxLength": 32
          }
        }
      }
    },
    "required": [
      "quoteId"
    ]
  },
  "booking-action": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "maxLength": 100
      },
      "expectedVersion": {
        "type": "integer",
        "minimum": 1
      },
      "action": {
        "type": "string",
        "enum": [
          "approve",
          "decline",
          "cancel",
          "checkin",
          "complete",
          "no_show",
          "approve_change",
          "decline_change",
          "offer_event",
          "accept_event",
          "assign_rooms",
          "withdraw_change",
          "withdraw_offer"
        ]
      },
      "amount": {
        "type": "integer",
        "minimum": 10000,
        "maximum": 100000000
      },
      "units": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 100
        },
        "minItems": 1,
        "maxItems": 9,
        "uniqueItems": true
      },
      "holdHours": {
        "type": "integer",
        "minimum": 1,
        "maximum": 72
      },
      "changeId": {
        "type": "string",
        "maxLength": 128
      },
      "offerId": {
        "type": "string",
        "maxLength": 128
      }
    },
    "required": [
      "id",
      "expectedVersion",
      "action"
    ]
  },
  "note": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "maxLength": 100
      },
      "expectedVersion": {
        "type": "integer",
        "minimum": 1
      },
      "note": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "required": [
      "id",
      "expectedVersion",
      "note"
    ]
  },
  "change-quote": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "maxLength": 100
      },
      "expectedVersion": {
        "type": "integer",
        "minimum": 1
      },
      "arrival": {
        "type": "string",
        "format": "date"
      },
      "departure": {
        "type": "string",
        "format": "date"
      },
      "guests": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200
      },
      "promo": {
        "type": "string",
        "maxLength": 32
      },
      "kind": {
        "type": "string",
        "enum": [
          "day",
          "individual",
          "private",
          "event"
        ]
      },
      "adults": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "childrenAges": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      }
    },
    "required": [
      "id",
      "expectedVersion",
      "arrival",
      "departure",
      "guests"
    ]
  },
  "change-request": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "maxLength": 100
      },
      "expectedVersion": {
        "type": "integer",
        "minimum": 1
      },
      "quoteId": {
        "type": "string",
        "maxLength": 100
      }
    },
    "required": [
      "id",
      "expectedVersion",
      "quoteId"
    ]
  },
  "settings": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "expectedVersion": {
        "type": "integer",
        "minimum": 1
      },
      "capacity": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "approvalHours": {
        "type": "integer",
        "minimum": 1,
        "maximum": 72
      },
      "cancelHours": {
        "type": "integer",
        "minimum": 0,
        "maximum": 336
      },
      "friendAt": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "familyAt": {
        "type": "integer",
        "minimum": 2,
        "maximum": 200
      },
      "friendDiscount": {
        "type": "integer",
        "minimum": 0,
        "maximum": 50
      },
      "familyDiscount": {
        "type": "integer",
        "minimum": 0,
        "maximum": 50
      },
      "paused": {
        "type": "boolean"
      },
      "products": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dayAdultRate": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "dayChildRate": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "individualRate": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "roomRate": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "extraChildRate": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "siteAdults": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "nightAdults": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "dayStart": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "dayEnd": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "stayStart": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "stayEnd": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "eventDayRate": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          }
        }
      },
      "facilities": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "available"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "available": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "required": [
      "expectedVersion",
      "capacity",
      "approvalHours",
      "cancelHours",
      "friendAt",
      "familyAt",
      "friendDiscount",
      "familyDiscount",
      "paused"
    ]
  },
  "unit": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "maxLength": 100
      },
      "expectedVersion": {
        "type": "integer",
        "minimum": 1
      },
      "capacity": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
      },
      "rate": {
        "type": [
          "integer",
          "null"
        ],
        "minimum": 10000,
        "maximum": 100000000
      },
      "active": {
        "type": "boolean"
      },
      "name": {
        "type": "string",
        "maxLength": 120
      },
      "verified": {
        "type": "boolean"
      }
    },
    "required": [
      "id",
      "expectedVersion",
      "capacity",
      "rate",
      "active"
    ]
  },
  "promo": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "code": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]{4,24}$"
      },
      "kind": {
        "type": "string",
        "enum": [
          "percent",
          "fixed"
        ]
      },
      "value": {
        "type": "integer",
        "minimum": 1
      },
      "maxUses": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "from": {
        "type": "string",
        "format": "date"
      },
      "until": {
        "type": "string",
        "format": "date"
      },
      "active": {
        "type": "boolean"
      },
      "expectedVersion": {
        "type": "integer",
        "minimum": 1
      }
    },
    "required": [
      "code"
    ]
  },
  "block": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "arrival": {
        "type": "string",
        "format": "date"
      },
      "departure": {
        "type": "string",
        "format": "date"
      },
      "unitId": {
        "type": "string",
        "maxLength": 100
      },
      "reason": {
        "type": "string",
        "maxLength": 120
      }
    },
    "required": [
      "arrival",
      "departure",
      "unitId",
      "reason"
    ]
  },
  "unblock": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "maxLength": 100
      }
    },
    "required": [
      "id"
    ]
  },
  "guest-contact": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id"
    ],
    "properties": {
      "id": {
        "type": "string",
        "maxLength": 100
      }
    }
  },
  "readiness": {
    "type": "object",
